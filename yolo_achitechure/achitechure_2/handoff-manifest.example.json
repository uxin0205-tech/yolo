    "pose_names": {
      "0": "ball",
      "1": "bat"
    }
  },
  "candidate_regions": [
    {
      "region_id": "shared",
      "role": "shared",
      "tasks": [
        "detect",
        "pose"
      ],
      "module_paths": [
        "fusion.shared_trunk.c3k2_0",
        "fusion.shared_trunk.c3k2_1"
      ],
      "head_paths": [
        "detect_head",
        "pose_head"
      ]
    }
  ],
  "protected_module_paths": [
    "fusion.inherited_masf",
    "fusion.inherited_attention",
    "detect_head",
    "pose_head"
  ],
  "frozen_module_paths": [
    "fusion.inherited_masf",
    "fusion.inherited_attention"
  ]
}
