[Unit]
Description=YOLO11 BinaryAttention formal experiment matrix
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/hplab/uxin/yolo11/yolo_binaryqk
ExecStart=/home/hplab/uxin/yolo11/yolo_binaryqk/run_formal_plan.sh
Restart=on-failure
RestartSec=60
KillMode=control-group
TimeoutStopSec=30
UMask=0002

[Install]
WantedBy=default.target
